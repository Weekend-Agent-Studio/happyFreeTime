# HappyFreeTime 本地配置模板。复制为 .env 后只在本机填写，禁止提交 .env。

# ---- LLM 模型配置 ----
# 模型名称，DeepSeek 可用: deepseek-chat / deepseek-v4-flash
MODEL_NAME=deepseek-chat

# HFT_DEMO_MODE=0 或 HFT_PLANNING_INTENT_MODE=llm 时必填
LLM_API=

# API Base URL
# DeepSeek: https://api.deepseek.com
# 其他兼容 OpenAI 格式的接口也可填入
BASE_URL=https://api.deepseek.com

# ---- Router 与 PlanningIntent 模式 ----
# 1 = 强制离线 Demo Router；0 = 强制真实 Router；不配置时根据 LLM_API 自动选择。
# 注意：HFT_DEMO_MODE 只控制 Router，不控制 PlanningIntent。
HFT_DEMO_MODE=1

# PlanningIntent 结构决策：
# rule = 确定性规则（默认、完全离线、可复现）
# llm = LLM 仅处理软偏好的节奏/角色/站数/顺序，失败自动回退 rule
HFT_PLANNING_INTENT_MODE=rule
# PlanningIntent 单次模型调用超时（秒）；仅 llm 模式使用
HFT_PLANNING_INTENT_TIMEOUT_SECONDS=15

# ---- 高德 Web 服务：后端天气与驾车路线 ----
# mock / replay / live / record。首次真实验证建议两个都设为 live。
HFT_PROVIDER_MODE=mock
HFT_ROUTE_PROVIDER_MODE=mock
AMAP_WEB_SERVICE_KEY=

# ---- 高德地图 JS API 2.0：前端真实地图 ----
# 两项必须成对填写。JS Key 会公开给浏览器；securityJsCode 只留在后端，
# 由 /_AMapService 安全代理追加，不会进入 Vite 构建产物。
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=

# 如需使用其他模型供应商，修改上述三个 LLM 值即可
# 例如用 OpenAI:
#   MODEL_NAME=gpt-4o
#   LLM_API=sk-xxxxxxxx
#   BASE_URL=https://api.openai.com/v1
