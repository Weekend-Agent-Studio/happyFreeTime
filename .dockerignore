# Default deny: local credentials, databases, archives and personal drafts are
# never part of either image's build context.
**
!requirements.txt
!app/
!app/**
!data/
!data/catalog/
!data/catalog/**
!data/demo_world/
!data/demo_world/**
!data/demo_showcases/
!data/demo_showcases/**
!data/fixtures/
!data/fixtures/**
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!deploy/
!deploy/backend.Dockerfile
!deploy/web.Dockerfile
!deploy/backup_volume.py
!deploy/smoke.py
!deploy/nginx/
!deploy/nginx/**

# Final exclusions also apply inside the allowed source trees.
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.pem
**/*.key
**/*.log
**/node_modules/**
**/dist/**
