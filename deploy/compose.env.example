# Compose interpolation only. No secrets belong in this file.
# Replace with the checked-out Git SHA before building.
HFT_RELEASE=demo-local
HFT_API_TARGET=rag
# Optional HTTPS Python package mirror for builds; CPU torch keeps its official index.
HFT_PIP_INDEX_URL=https://pypi.org/simple
HFT_BIND_ADDRESS=127.0.0.1
HFT_HTTP_PORT=8080
HFT_HTTPS_PORT=443
HFT_API_MEMORY_LIMIT=1536m
# Keep these three addresses in the same unused Docker subnet.
HFT_NETWORK_SUBNET=172.30.88.0/24
HFT_PROXY_IP=172.30.88.2
HFT_API_IP=172.30.88.3
