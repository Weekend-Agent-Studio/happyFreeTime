# Runtime-only settings. Copy to runtime.env; never commit the real file.
# First deployment uses no paid site services. Visitor DeepSeek is optional BYOK.
HFT_DEMO_MODE=1
HFT_PLANNING_INTENT_MODE=rule
HFT_RECOMMENDATION_ADVISOR_MODE=rule
HFT_CANDIDATE_RETRIEVER_MODE=hybrid
HFT_RETRIEVAL_PREWARM=true
HFT_CATALOG_MODE=demo
HFT_PLANNER_SEARCH_MODE=beam
HFT_PROVIDER_MODE=mock
HFT_ROUTE_PROVIDER_MODE=mock
HFT_GEOCODING_PROVIDER_MODE=mock
HFT_MOCK_WEATHER=晴
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
# To enable Amap, set both JS credentials above for the browser map.
# With AMAP_WEB_SERVICE_KEY, explicitly change all three provider modes to live
# for real departure search, routes and weather. No visitor LLM Key is required.
