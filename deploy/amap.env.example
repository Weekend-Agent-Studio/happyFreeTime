# Copy to deploy/amap.env on the server; never commit the real values.
# This enables site-funded live map/search/routes/weather, independent of BYOK.
HFT_PROVIDER_MODE=live
HFT_ROUTE_PROVIDER_MODE=live
HFT_GEOCODING_PROVIDER_MODE=live
# Match the account's driving 2.0 QPS quota; conservative single-worker default.
HFT_AMAP_ROUTE_QPS=1
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
