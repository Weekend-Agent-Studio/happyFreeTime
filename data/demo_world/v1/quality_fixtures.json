{
  "schema_version": "demo-world-quality-fixture.v1",
  "version": "v1",
  "purpose": "Deterministic quality checks for bounded multi-stop planning; not a production success-rate dataset.",
  "cases": [
    {
      "case_id": "explicit_single_activity",
      "request": {
        "start_at": "14:00",
        "end_at": "18:00",
        "exact_stop_count": 1,
        "required_roles": ["activity"]
      },
      "expect": {
        "exact_stop_count": 1,
        "required_role_sequence": ["activity"]
      }
    },
    {
      "case_id": "explicit_lunch_activity_dinner",
      "request": {
        "start_at": "09:00",
        "end_at": "21:00",
        "exact_stop_count": 3,
        "required_roles": ["lunch", "activity", "dinner"]
      },
      "expect": {
        "exact_stop_count": 3,
        "required_role_sequence": ["lunch", "activity", "dinner"]
      }
    },
    {
      "case_id": "all_day_prefers_coverage",
      "request": {
        "start_at": "09:00",
        "end_at": "21:00",
        "trip_time_scope": "all_day",
        "preferences": ["浪漫"]
      },
      "expect": {
        "minimum_stop_count": 3,
        "minimum_schedule_span_minutes": 600,
        "required_periods": ["morning", "afternoon", "evening"]
      }
    },
    {
      "case_id": "short_window_does_not_pad_stops",
      "request": {
        "start_at": "14:00",
        "end_at": "18:00",
        "exact_stop_count": 2,
        "required_roles": ["activity", "dinner"]
      },
      "expect": {
        "exact_stop_count": 2,
        "required_role_sequence": ["activity", "dinner"],
        "maximum_schedule_span_minutes": 240
      }
    },
    {
